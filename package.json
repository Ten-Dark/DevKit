{
  "name": "devkit",
  "version": "1.0.3",
  "type": "module",
  "description": "A Windows desktop toolbox for project and XMind-to-Markdown workflows.",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "preinstall": "node scripts/check-node-version.cjs",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite",
    "build": "tsc && tsc --target ES2022 --module commonjs --moduleResolution node --outDir dist-electron/preload-cjs --skipLibCheck --esModuleInterop --types node,electron src/preload/preload.ts && node scripts/rename-preload.mjs && node scripts/build-windows-native.cjs && vite build",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism --testTimeout=60000",
    "test:e2e:dev": "playwright test tests/e2e/dev.spec.ts",
    "test:e2e:packaged": "playwright test tests/e2e/packaged.spec.ts",
    "preview": "vite preview",
    "electron": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:from-build": "node scripts/pre-dist-validate.mjs && electron-builder --publish never && node scripts/generate-update-metadata.mjs",
    "dist": "npm run build && npm run dist:from-build",
    "package": "npm run dist && npm run validate:asar",
    "validate:asar": "node scripts/validate-asar.mjs",
    "check": "npm run lint && tsc --noEmit && npm test",
    "verify:local": "npm run check && npm run build",
    "verify:e2e": "npm run test:e2e:dev",
    "test:e2e:updater": "playwright test tests/e2e/updater-lifecycle.spec.ts",
    "release:check": "npm run check && npm run test:e2e:dev && npm run build && npm run dist:from-build && npm run validate:asar && npm run test:e2e:packaged",
    "verify:release": "npm run release:check",
    "lint": "eslint .",
    "test:native:windows": "node scripts/test-windows-native.cjs && node scripts/test-windows-provider-electron.cjs",
    "postbuild": "npm run test:native:windows"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/electron-builder": "^2.0.29",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.1.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-dom": "5.30.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-jsx": "5.30.5",
    "eslint-plugin-react-x": "5.30.5",
    "globals": "17.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.0",
    "node-gyp": "^12.4.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "builder-util-runtime": "9.7.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "ignore": "^5.3.2",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "yauzl": "3.4.0"
  },
  "build": {
    "productName": "Dev Toolbox",
    "appId": "com.devtoolbox.app",
    "extraResources": [
      {
        "from": "src/main/updater/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Ten-Dark",
        "repo": "DevKit",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist-electron/main/**/*",
      "dist-electron/preload/preload.cjs",
      "dist-electron/shared/**/*",
      "dist-electron/renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "guid": "6A3C1F2E-8D4B-4C9A-9E1F-5B7D3A2C4E6F"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "esbuild@0.21.5": true
  }
}
