{
  "name": "dev-toolbox",
  "version": "1.0.1",
  "type": "module",
  "description": "",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:e2e:dev": "playwright test tests/e2e/dev.spec.ts",
    "test:e2e:packaged": "playwright test tests/e2e/packaged.spec.ts",
    "preview": "vite preview",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "validate:asar": "node scripts/validate-asar.mjs",
    "verify:release": "npm run test && npm run build && npm run validate:asar && npm run dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/electron-builder": "^2.0.29",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.5",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.0",
    "playwright-electron": "^0.5.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "build": {
    "productName": "Dev Toolbox",
    "appId": "com.devtoolbox.app",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist-electron/main/**/*",
      "dist-electron/preload/preload.js",
      "dist-electron/shared/**/*",
      "dist-electron/renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "guid": "6A3C1F2E-8D4B-4C9A-9E1F-5B7D3A2C4E6F"
    }
  }
}
